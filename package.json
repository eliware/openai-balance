{
  "name": "@eliware/openai-balance",
  "version": "13.0.0",
  "type": "module",
  "description": "Show the current OpenAI credit balance in one terminal line.",
  "keywords": [
    "openai",
    "balance",
    "credits",
    "terminal",
    "cli"
  ],
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./src/index.mjs",
  "bin": {
    "openai-balance": "./bin/openai-balance.mjs"
  },
  "files": [
    "src/",
    "docs/",
    "README.md",
    "AGENTS.md",
    "LICENSE",
    "RELEASE_NOTES.md",
    "bin/",
    "specs/",
    ".env.example"
  ],
  "scripts": {
    "start": "node bin/openai-balance.mjs",
    "test": "eliware-test",
    "lint": "eliware-test --lint",
    "audit": "eliware-test --audit",
    "format": "eliware-test --format",
    "format:check": "eliware-test --format-check",
    "pack": "eliware-test --pack"
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@eliware/common": "^12.0.1"
  },
  "devDependencies": {
    "@eliware/test": "^13.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.mjs"
    ],
    "collectCoverageFrom": [
      "src/**/*.mjs"
    ],
    "coverageReporters": [
      "text",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    }
  },
  "prettier": {
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": false,
    "quoteProps": "as-needed",
    "jsxSingleQuote": false,
    "trailingComma": "all",
    "bracketSpacing": true,
    "bracketSameLine": false,
    "arrowParens": "always",
    "proseWrap": "preserve",
    "endOfLine": "lf"
  },
  "author": "Eliware <eliware@eliware.org>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eliware/openai-balance.git"
  },
  "homepage": "https://github.com/eliware/openai-balance#readme",
  "bugs": {
    "url": "https://github.com/eliware/openai-balance/issues"
  },
  "eliware": {
    "id": "E-1140",
    "apply": [
      "general",
      "application",
      "cli",
      "npm-published"
    ]
  },
  "exports": {
    ".": "./src/index.mjs"
  }
}
